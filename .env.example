# ---- LLM（二选一） ----
# OpenAI 兼容（默认）
OPENAI_API_KEY=
# 可选：指向任意 OpenAI 兼容网关/代理
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Anthropic（把 LLM_PROVIDER 改成 anthropic 并填 key）
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=

# ---- 可观测性（可选） ----
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-playbook
LOG_LEVEL=INFO

# ---- 持久化（可选；不填回退到内存） ----
POSTGRES_URI=

# ---- 运行时 ----
MAX_STEPS=25
RECURSION_LIMIT=50
